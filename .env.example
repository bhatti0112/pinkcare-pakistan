# GEMINI_API_KEY: Required for Ask PinkCare AI assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: 'development' or 'production'
NODE_ENV="development"

# MONGODB_URI: Optional MongoDB connection string (e.g. mongodb://localhost:27017/pinkcare)
MONGODB_URI="mongodb://localhost:27017/pinkcare"

# SESSION_SECRET: Secret for signing cookies and session tokens
SESSION_SECRET="pinkcare_super_secure_session_secret_change_in_production"

